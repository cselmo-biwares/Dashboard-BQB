APP_NAME="dashboard-bqb"

# Destination Postgres (topic tree, documents, conversation classifications)
DB_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/dashboard_bqb"

# Conversation Manager (source of conversations/messages, already decrypted)
CONVERSATION_MANAGER__URL="http://localhost:8000"
CONVERSATION_MANAGER__TIMEOUT=30

# AWS Bedrock (AnthropicBedrock client used for classification/restructure)
BEDROCK__REGION_NAME="us-east-1"
BEDROCK__ACCESS_KEY_ID=""
BEDROCK__SECRET_ACCESS_KEY=""
BEDROCK__MODEL="us.anthropic.claude-sonnet-4-6"
BEDROCK__MAX_TOKENS=4000
BEDROCK__TEMPERATURE=0.0


# Conversation ingestion pipeline (/ingestion/update)
INGESTION__MIN_AGE_HOURS=2
INGESTION__PAGE_SIZE=50
INGESTION__LOCK_TTL_SECONDS=3600

# Comma-separated list of allowed origins for the (separately deployed) React front.
# Leave empty to disable CORS entirely.
CORS_ORIGINS=""

# Auth: session JWTs + the single admin account's credentials.
# No defaults on purpose - a misconfigured deployment must fail to start, not run with a
# weak/well-known secret.
AUTH__JWT_SECRET=""
AUTH__ADMIN_USERNAME=""
AUTH__ADMIN_PASSWORD=""

# OTEL Config

## Connection
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

## Base
# Set to true to disable all OTEL exporting
OTEL_SDK_DISABLED=false

OTEL_RESOURCE_ATTRIBUTES="service.name=dashboard-bqb"
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=grpc
OTEL_LOG_LEVEL="debug"
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true

## Metrics
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
OTEL_METRIC_EXPORT_INTERVAL=2000
OTEL_METRIC_EXPORT_TIMEOUT=5000

## Spans batch config
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_EXPORT_TIMEOUT=3000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512

## Logging batch config
OTEL_BLRP_SCHEDULE_DELAY=5000
OTEL_BLRP_EXPORT_TIMEOUT=3000
OTEL_BLRP_MAX_QUEUE_SIZE=2048
OTEL_BLRP_MAX_EXPORT_BATCH_SIZE=512

## FastAPI OTEL instrumentation
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=""
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST=""
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_RESPONSE=""
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SANITIZE_FIELDS=""